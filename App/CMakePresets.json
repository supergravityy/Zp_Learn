{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug (all features)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_FLAGS": "-Wno-error=unused-but-set-variable"
      }
    }
  ],
  "buildPresets": [ { "name": "dev", "configurePreset": "dev", "jobs": 4 } ]
}
